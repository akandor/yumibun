    "Pick some sounds, then tap ... in the player and select 'Add to presets' to save the mix as a preset." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einige Sounds aus, tippe dann im Player auf … und wähle „Zu Presets hinzufügen“, um den Mix als Voreinstellung zu speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige algunos sonidos, luego toca ... en el reproductor y selecciona «Añadir a preajustes» para guardar la mezcla como preajuste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez quelques sons, puis touchez ... dans le lecteur et sélectionnez « Ajouter aux préréglages » pour enregistrer le mix comme préréglage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli alcuni suoni, poi tocca ... nel player e seleziona «Aggiungi ai preset» per salvare il mix come preset."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サウンドをいくつか選び、プレーヤーの … をタップして「プリセットに追加」を選ぶと、ミックスをプリセットとして保存できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사운드를 몇 개 선택한 다음 플레이어에서 … 을 탭하고 '프리셋에 추가'를 선택하면 믹스를 프리셋으로 저장할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha alguns sons, toque em ... no player e selecione \"Adicionar às predefinições\" para salvar a mixagem como predefinição."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先选择一些音效，然后点按播放器中的 ...，选择“添加到预设”即可将混音保存为预设。"
          }
        }
      }
    },
