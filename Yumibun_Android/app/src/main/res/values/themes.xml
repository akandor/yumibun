<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Yumibun" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Android 12+ system splash: just the brand background (a transparent icon so
             no logo shows here), handing over to the animated Compose SplashScreen, which
             owns the single logo moment. -->
        <item name="android:windowSplashScreenBackground">#0C0C0E</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
</resources>
